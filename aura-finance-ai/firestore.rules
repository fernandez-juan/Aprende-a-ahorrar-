rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId) && request.resource.data.email is string;

      match /transactions/{transactionId} {
        allow list, get: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(transactionId);
        allow delete: if isOwner(userId);
      }

      match /goals/{goalId} {
        allow list, get: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(goalId);
        allow delete: if isOwner(userId);
      }

      match /investments/{investmentId} {
        allow list, get: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(investmentId);
        allow delete: if isOwner(userId);
      }
    }
  }
}
